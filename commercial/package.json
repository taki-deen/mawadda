{
  "name": "mawadda-commercial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12 || >=24" },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run build && tsx server/index.ts --demo",
