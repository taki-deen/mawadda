    "@prisma/adapter-pg": "~7.6.0",
    "@prisma/client": "~7.6.0",
    "@supabase/supabase-js": "~2.100.0",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prisma": "~7.6.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  }
